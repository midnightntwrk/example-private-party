# Copy this to .env.preprod and fill in ONE of MNEMONIC or SEED per role
# (Alice, Bob, Charlie, Dave). The Private Party test exercises Alice, Bob and
# Charlie, and EACH of those must be funded with tNIGHT and tDUST.
#
# Dave is the exception, and it is deliberate: the DUST sponsorship suite needs a
# wallet that holds tNIGHT but has NO DUST. See docs/SPONSORSHIP.md.
#
# Fund via the Preprod faucet (https://midnight-tmnight-preprod.nethermind.dev/)
# Each wallet MUST also have DUST, which you can delegate in 1AM or Lace Carbon.

# Alice (party organizer) — set only one, delete the other
MIDNIGHT_PREPROD_ALICE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_ALICE_SEED=replace-with-a-64-char-hex-seed

# Bob (party goer) — set only one, delete the other
MIDNIGHT_PREPROD_BOB_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_BOB_SEED=replace-with-a-64-char-hex-seed

# Charlie (party goer) — set only one, delete the other
MIDNIGHT_PREPROD_CHARLIE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_CHARLIE_SEED=replace-with-a-64-char-hex-seed

# Dave (sponsored guest) — set only one, delete the other.
# Dave is used by the DUST sponsorship suite. He MUST hold tNIGHT (to pay the party
# entry fee) but MUST NOT have DUST delegated — the whole point is that his fees are
# paid by Alice. If Dave has DUST, the sponsorship suite fails with a clear message.
MIDNIGHT_PREPROD_DAVE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_DAVE_SEED=replace-with-a-64-char-hex-seed
