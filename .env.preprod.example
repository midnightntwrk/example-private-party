# Copy this to .env.preprod and fill in ONE of MNEMONIC or SEED per role
# (Alice, Bob, Claire). The Private Party test exercises all three wallets,
# so EACH must be funded with tNIGHT and tDUST.
#
# Fund via the Preprod faucet (https://midnight-tmnight-preprod.nethermind.dev/)
# Each wallet MUST also have DUST, which you can delegate in 1AM or Lace Carbon.

# Alice (party organizer) — set only one, delete the other
MIDNIGHT_PREPROD_ALICE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_ALICE_SEED=replace-with-a-64-char-hex-seed

# Bob (party goer) — set only one, delete the other
MIDNIGHT_PREPROD_BOB_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_BOB_SEED=replace-with-a-64-char-hex-seed

# Claire (party goer) — set only one, delete the other
MIDNIGHT_PREPROD_CLAIRE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_CLAIRE_SEED=replace-with-a-64-char-hex-seed
