# Copy this to .env.preview and fill in ONE of MNEMONIC or SEED per role
# (Alice, Bob, Charlie). The Private Party test exercises all three wallets,
# so EACH must be funded with tNIGHT and tDUST.
#
# Fund via the Preview faucet (https://midnight-tmnight-preview.nethermind.dev/)
# Each wallet MUST also have DUST, which you can delegate in 1AM or Lace Carbon.

# Alice (party organizer) — set only one, delete the other
MIDNIGHT_PREVIEW_ALICE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREVIEW_ALICE_SEED=replace-with-a-64-char-hex-seed

# Bob (party goer) — set only one, delete the other
MIDNIGHT_PREVIEW_BOB_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREVIEW_BOB_SEED=replace-with-a-64-char-hex-seed

# Charlie (party goer) — set only one, delete the other
MIDNIGHT_PREVIEW_CHARLIE_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREVIEW_CHARLIE_SEED=replace-with-a-64-char-hex-seed
